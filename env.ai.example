# ========================================
# CONFIGURACIÓN DE IA - OpenAI
# ========================================

# Tu API Key de OpenAI (requerido)
# Obtén tu key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Organización de OpenAI (opcional)
# OPENAI_ORG_ID=org-XXXXXXXXXXXXX

# ========================================
# CONFIGURACIÓN DE IA - Opciones
# ========================================

# Activar/desactivar sistema de IA
AI_ENABLED=true

# Nivel mínimo de confianza para auto-responder (0.0 - 1.0)
AI_MIN_CONFIDENCE=0.7

# Delay antes de respuesta automática (milisegundos)
AI_RESPONSE_DELAY=2000

# Activar transcripción de notas de voz
AI_VOICE_TRANSCRIPTION=true

# Guardar análisis de IA en logs
AI_SAVE_ANALYSIS=true

# Categorías que pueden recibir auto-respuesta (separadas por coma)
AI_AUTO_RESPOND_CATEGORIES=greeting,question

# Máximo de mensajes en contexto para IA
AI_MAX_CONTEXT_MESSAGES=10

# ========================================
# CONFIGURACIÓN EXISTENTE DE WHATSAPP
# ========================================

# (Mantener tu configuración existente)
WHATSAPP_ACCESS_TOKEN=tu_token_actual
WHATSAPP_PHONE_NUMBER_ID=tu_phone_id
WEBHOOK_VERIFY_TOKEN=tu_verify_token

# ========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ========================================

# (Mantener tu configuración existente)
DATABASE_URL=tu_database_url

# ========================================
# NOTAS IMPORTANTES
# ========================================

# 1. OPENAI_API_KEY es OBLIGATORIA para que funcione el sistema de IA
# 2. Los costos de OpenAI se cobran según uso:
#    - GPT-4o-mini: ~$0.15 por 1M de tokens de entrada
#    - Whisper: ~$0.006 por minuto de audio
# 3. Para producción, considera implementar rate limiting
# 4. Monitorea tu uso en: https://platform.openai.com/usage
